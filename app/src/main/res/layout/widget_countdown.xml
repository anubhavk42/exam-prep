<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizontal split layout — content flows across the WIDTH, never stacked into
    a tall column that can overflow vertically. See CLAUDE.md
    "Bug fix + redesign: Home Screen Widget text clipping".

    [ 90            |  🔥 5 day streak        ]
    [ DAYS LEFT     |  Tap to start today →   ]   (CTA row hidden once today is done)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    tools:ignore="HardcodedText">

    <!-- LEFT: days-remaining number + label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8B869"
            android:textSize="36sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—" />

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#8A8380"
            android:textSize="9sp"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="DAYS LEFT" />
    </LinearLayout>

    <!-- Thin vertical divider (ImageView, not View — RemoteViews forbids bare View) -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#2A2422"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- RIGHT: streak row + conditional CTA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_streak_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:includeFontPadding="false"
                android:text="🔥" />

            <TextView
                android:id="@+id/widget_streak_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="#F0ECE6"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#8A8380"
                android:textSize="10sp"
                android:maxLines="1"
                android:text="day streak" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#E8B869"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Tap to start today →" />
    </LinearLayout>

</LinearLayout>
